{
  "name": "rapid-response-africa-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for The Rapid Response Africa (Node.js + Express + PostgreSQL/Neon)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "setup": "npm run migrate && npm run seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "pg": "^8.16.3"
  }
}
