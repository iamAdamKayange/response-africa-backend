# --- Database (Neon) -------------------------------------------------------
# Neon dashboard → Connection details → copy the *pooled* connection string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Server ----------------------------------------------------------------
PORT=4000
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Extra sites allowed to call the API (comma-separated). *.rapid-response.africa and the Vercel URLs are always allowed.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Demo accounts created by `npm run seed` -------------------------------
# Change these before seeding production, or change the passwords from the panel afterwards.
SEED_ADMIN_NAME=Editor-in-Chief
SEED_ADMIN_EMAIL=admin@rapid-response.com
SEED_ADMIN_PASSWORD=Admin@2026!
SEED_AUTHOR_NAME=Staff Writer
SEED_AUTHOR_EMAIL=author@rapid-response.com
SEED_AUTHOR_PASSWORD=Author@2026!

# --- Cloudflare R2 image uploads (optional) -------------------------------
# R2 → Manage API tokens → create an S3 token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=africa-response-backet
# Public address of the bucket (R2 → bucket → Settings → Public access: r2.dev URL or a custom domain),
# e.g. https://pub-xxxxxxxx.r2.dev or https://media.rapid-response.com
# Leave empty to serve images through this API at /api/media/... instead.
R2_PUBLIC_URL=

# --- Newsletter emails (Resend) -------------------------------------------------
# resend.com → API Keys → Create (permission: Sending access). Leave empty to turn email off.
RESEND_API_KEY=
# Must be on a domain verified in Resend (Domains → Add → rapid-response.africa).
EMAIL_FROM=The Rapid Response Africa <brief@rapid-response.africa>
EMAIL_REPLY_TO=
# Used to build links inside emails.
SITE_URL=https://rapid-response.africa
API_PUBLIC_URL=https://api.rapid-response.africa
# Email every article the first time it is published.
EMAIL_ARTICLE_ALERTS=true
# The Daily Brief: weekdays at this hour (local time), only if something new was published.
DAILY_BRIEF_ENABLED=true
DAILY_BRIEF_HOUR=7
DAILY_BRIEF_TZ=Africa/Nairobi
