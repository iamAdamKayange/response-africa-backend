# --- Database (Neon) -------------------------------------------------------
# Neon dashboard → Connection details → copy the *pooled* connection string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Server ----------------------------------------------------------------
PORT=4000
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of sites allowed to call the API (your Vercel URL + local dev)
CORS_ORIGIN=http://localhost:3000,https://rapid-response-africa.vercel.app

# --- Demo accounts created by `npm run seed` -------------------------------
# Change these before seeding production, or change the passwords from the panel afterwards.
SEED_ADMIN_NAME=Editor-in-Chief
SEED_ADMIN_EMAIL=admin@rapid-response.com
SEED_ADMIN_PASSWORD=Admin@2026!
SEED_AUTHOR_NAME=Staff Writer
SEED_AUTHOR_EMAIL=author@rapid-response.com
SEED_AUTHOR_PASSWORD=Author@2026!
